# Backend only. Never expose the service-role key in a VITE_ variable.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
LTI_PUBLIC_URL=https://YOUR_HTTPS_BACKEND
LTI_PARTICIPANT_URL=http://localhost:3001
# UF production Canvas uses the shared Canvas issuer, not the UF course hostname.
# Confirm the issuer and deployment ID with UF; no wildcard deployments are accepted.
LTI_REGISTRATIONS_JSON=[{"id":"uf-production","issuer":"https://canvas.instructure.com","client_id":"UF_CLIENT_ID","deployment_ids":["UF_DEPLOYMENT_ID"],"auth_url":"https://sso.canvaslms.com/api/lti/authorize_redirect","jwks_url":"https://sso.canvaslms.com/api/lti/security/jwks"}]
# Generate a key with generate_lti_key.py; paste only the public JWK JSON here.
LTI_TOOL_PUBLIC_JWK=
